        {
          "name": "Create booking — Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/bookings/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listing_id\": \"{{listing_id}}\",\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dateAfter = n => { const d = new Date(); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }; pm.environment.set(\"check_in\", dateAfter(30)); pm.environment.set(\"check_out\", dateAfter(33));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json(); pm.test(\"Pending booking\", () => pm.expect(j.status).to.eql(\"PENDING\")); pm.environment.set(\"booking_id\", j.id);",
                  "const quoted = pm.response.json().total_price;",
                  "pm.test(\"Total price is a positive fixed two-decimal quote\", () => { pm.expect(Number(quoted).toFixed(2)).to.eql(quoted); pm.expect(Number(quoted)).to.be.above(0); });",
                  "pm.environment.set(\"booking_total_price\", quoted);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm booking — Landlord",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/bookings/{{booking_id}}/confirm/",
            "auth": {
              "type": "bearer",
