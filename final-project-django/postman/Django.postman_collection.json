{
  "info": {
    "name": "Python Developer — Final Project (Django)",
    "description": "LMS 271. All accounts and data are synthetic. Set the two local demo passwords in the private Postman environment. Run Demo flow in folder order; other folders are reference and edge-case requests. Secrets are never part of this exported collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tenant_access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Demo flow",
      "item": [
        {
          "name": "Login — Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{tenant_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json(); pm.test(\"JWT pair\", () => { pm.expect(j.access).to.be.a(\"string\"); pm.expect(j.refresh).to.be.a(\"string\"); }); pm.environment.set(\"tenant_access_token\", j.access); pm.environment.set(\"tenant_refresh_token\", j.refresh);"
                ]
              }
            }
          ]
        },
