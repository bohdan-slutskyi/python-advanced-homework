# Local development / Docker Compose template. Copy to .env; never commit secrets.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BIND_PORT=18765

# Compose MySQL is isolated from the Homebrew MySQL service (no host DB port).
MYSQL_DATABASE=housing_rental_compose
MYSQL_USER=housing_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_SSL_REQUIRED=false
MYSQL_TEST_DATABASE=test_housing_rental_compose
